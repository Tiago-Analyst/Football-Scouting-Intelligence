# =============================================================================
# Football Recruitment Intelligence - environment template
# =============================================================================
# Copy to `.env` and fill in. `.env` is git-ignored and must NEVER be committed.
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Application mode
# -----------------------------------------------------------------------------
# demo       -> MockPerformanceProvider only. No FootyStats calls. All data in
#               the UI is clearly labelled as mock/demo data.
# production -> Reads the processed production database built from
#               FootyStats + Transfermarkt.
APP_MODE=demo

# development | staging | production
# Controls error verbosity: only `development` may surface stack traces.
APP_ENV=development

# Set to true only for local debugging. Never true in a deployed environment.
DEBUG=true

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fri
POSTGRES_USER=fri_app
POSTGRES_PASSWORD=change_me_locally

# Optional: full URL. If set, it wins over the discrete POSTGRES_* values above.
# Managed providers (Neon, Supabase, Railway) usually hand you one of these.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# -----------------------------------------------------------------------------
# API server
# -----------------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# Comma-separated exact origins allowed to call the API from a browser.
# Do not use "*" - credentialed requests require explicit origins.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Requests per minute per client IP, applied to the public API surface.
RATE_LIMIT_PER_MINUTE=120

# -----------------------------------------------------------------------------
# FootyStats (performance data provider)
# -----------------------------------------------------------------------------
# A real key has been used and the field mapping validated against real
# responses (2026-08-29). See docs/footystats_provider_status.md, which is
# generated from config/footystats_mapping.yaml rather than maintained by hand.
#
# This key is server-side only. It must never appear in frontend code, in a
# browser request, in the git repository, or in application logs. In production
# it is supplied as a platform secret; in CI as a GitHub Actions secret.
#
# While empty, the application refuses to construct a FootyStatsProvider and
# falls back to the mock provider (in demo mode) or fails loudly (in production).
FOOTYSTATS_API_KEY=
FOOTYSTATS_BASE_URL=https://api.football-data-api.com

# -----------------------------------------------------------------------------
# Transfermarkt (market data)
# -----------------------------------------------------------------------------
# Public dataset: dcaribou/transfermarkt-datasets. We do not scrape the site.
TRANSFERMARKT_DATASET_REF=dcaribou/transfermarkt-datasets

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json -> structured logs for production. console -> human-readable for local.
LOG_FORMAT=console

# -----------------------------------------------------------------------------
# Build access
# -----------------------------------------------------------------------------
# Lifts the API rate limit for the deploy that prerenders the frontend, and for
# nothing else. The same value goes in the frontend as BUILD_TOKEN.
#
# It is not a credential: presenting it grants no access a public caller does
# not already have. Unset means the exemption does not exist, which is the
# right default anywhere the site is not prerendered.
BUILD_TOKEN=
