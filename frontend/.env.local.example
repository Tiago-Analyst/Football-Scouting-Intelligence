# Copy to `frontend/.env.local`. Git-ignored.
#
# NEXT_PUBLIC_* variables are inlined into the browser bundle. Only ever put
# non-secret values here. Provider API keys belong in the backend `.env` only.

# Base URL of the FastAPI backend, used by server-side route handlers.
API_BASE_URL=http://127.0.0.1:8000

# Shown in the UI so it is always obvious whether data is mock or production.
NEXT_PUBLIC_APP_MODE=demo
