      "label": "Ball Security",
      "description": "Keeping possession. Pass completion dominates; being dispossessed counts against, and is inverted automatically."
    },
    "chance_creation": {
      "label": "Chance Creation",
      "description": "Generating shots for team-mates. Weighted towards expected assists and key passes rather than assists themselves, which depend on whether a team-mate finished the chance."
    },
    "defensive_activity": {
      "label": "Defensive Activity",
      "description": "Volume of defensive actions. Measures how much a player does out of possession, not how well their team defends."
    },
    "duel_dominance": {
      "label": "Duel Dominance",
      "description": "Winning direct contests. Success rates are weighted above volume, because contesting many duels badly is not dominance."
    },
    "one_v_one_threat": {
      "label": "1v1 Threat",
      "description": "Beating an opponent directly. Fouls drawn are included because a defender who has to foul has also been beaten."
    },
    "goal_threat": {
      "label": "Goal Threat",
      "description": "Getting into positions to score. Built on expected goals and shot volume rather than goals, so it reflects the chances a player generates rather than whether they went in."
    },
