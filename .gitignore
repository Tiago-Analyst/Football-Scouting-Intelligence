# ---- Secrets -------------------------------------------------------------
# NEVER commit real credentials. FOOTYSTATS_API_KEY must not reach the repo.
.env
.env.*
# Template files carry no secrets and must be committed. This covers nested
# ones such as frontend/.env.local.example, which a bare !.env.example misses.
!*.example
*.pem
*.key
secrets/

# Credential notes kept loose in the working directory. `passneon.txt` held a
# Neon connection password and was one `git add -A` away from this repository's
# history, where a rotation is the only remedy.
#
# Named explicitly, and then by shape for the next one - which will not be
# called `passneon.txt`. Both patterns are anchored to the root and limited to
# `.txt` on purpose: this project has sign-in, registration and an account
# page, so an unanchored `*password*` would one day swallow a real component
# like `frontend/src/.../PasswordField.tsx` and it would vanish from the diff
# without anybody being told.
/passneon.txt
/pass*.txt
/*password*.txt
/*credentials*.txt

# ---- Python --------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage
.coverage.*
dist/
build/

# ---- Node / Next.js ------------------------------------------------------
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
.vercel/
npm-debug.log*
yarn-error.log*

# ---- Data ----------------------------------------------------------------
# Raw provider snapshots are large and licence-restricted: never commit them.
# Re-including .gitkeep requires first re-including the directories: git does
# not descend into an excluded directory, so a negation inside one never fires.
data/raw/**
!data/raw/**/
!data/raw/**/.gitkeep
# Snapshot manifests record the URL, checksum and retrieval time of a raw
# download. They are metadata, not provider data, and committing them is what
# makes "which snapshot produced this table?" answerable later.
!data/raw/**/*.manifest.json
data/processed/**
!data/processed/**/
!data/processed/**/.gitkeep
*.duckdb
*.duckdb.wal
*.parquet
*.sqlite
*.db

# Manual mapping overrides ARE tracked - they are curated project inputs.
!data/manual/**

# ---- OS / editor ---------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
.neon

# Agent skills are installed into .agents/ as real files, which are committed:
# a checkout should carry the same guidance this one used. What lives in
# .claude/skills/ are symlinks *to* them, holding this machine's absolute path -
# and with core.symlinks off on Windows, git would store that path as a text
# file pretending to be a skill directory.
.claude/skills/

# ---------------------------------------------------------------------------
# Identity-resolution output: personal data
# ---------------------------------------------------------------------------
# Row-level resolution output carries real people's names, dates of birth and
# nationalities - one row per player in the provider's universe. It was
# published to this public repository for a while, which was a mistake, and
# these rules exist so it cannot happen again by accident.
#
# The resolver writes the real file to `data/processed/`, already ignored
# above. These patterns cover the old location and any variant of the name, so
# a future change of output path does not quietly re-publish it.
#
# What IS committed: `docs/identity_resolution_footystats.md` (counts and
# shares, no individuals) and `docs/identity_resolution_example.csv` (six
# invented people, showing the columns).
docs/identity_resolution_footystats.csv
docs/identity_resolution*.csv
!docs/identity_resolution_example.csv

# Page captures taken for review. Regenerated on demand, never a source of truth.
/screenshots/
/football_validation_audit/
/football_validation_audit.zip
# Captures of the live site, so every one shows real players under their real
# names - the same reason `data/processed/` is ignored above. 58 MB between the
# directory and its zip, which is the other reason: a binary that large is
# never worth a commit when the page it shows can be opened again.
# By shape, not by name: `/prints_producao.zip` was an exact match, so the next
# capture - `prints-producao-2026-10-20.zip` - landed untracked in the root and
# was not covered by the rule written for exactly this.
/prints[-_]*
/capturas[-_]*
